<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>CodeDetective</AssemblyName>
    <RootNamespace>CodeDetective.WinForms</RootNamespace>
    <ApplicationIcon>CodeDetective.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\assets\*.*" Link="assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
